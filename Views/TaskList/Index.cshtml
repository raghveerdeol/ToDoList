@model IEnumerable<ToDoList.Models.TaskList>
@{
    ViewData["Title"] = "Index";
}

<div class="flex flex-center text-center mt-8">
    <h1 class="col-12">To DO List</h1>
    <div class="col-8 mt-8">
        <div class="flex flex-end col-12">
            <button 
                type="button" 
                class="btn-base btn-success btn-base-p px-2 py-1" 
                onclick="openCreateModal()" 
            >
                Add Task
            </button>    
        </div>
        <ul class="mt-8 no-list-style">
            @foreach (var SingleTask in Model)
            {
                <li>
                    <div class="flex flex-center text-start mt-2 col-12 p-list-item item-border @CompletedTask(@SingleTask.Completed, true)">
                        <div class="col-8">
                            @if(!@SingleTask.Completed){
                                <div class="mr-4">
                                    <form asp-action="CheckComplete" method="post">
                                        <input type="hidden" name="Id" asp-for="@SingleTask.Id">
                                            <Button type="submit" class="btn-base btn-base-p item-border border-base-c color-blue">Complete Task</Button>
                                    </form>
                                </div>
                            }
                            <div>
                                <h4 class="@CompletedTask(@SingleTask.Completed, false)">
                                    @SingleTask.Title
                                    @if(@SingleTask.Important)
                                    {
                                        <span class="color-yellow">
                                            &#127775;
                                        </span>
                                    }
                                </h4>
                                <p class="@CompletedTask(@SingleTask.Completed, false)">
                                    @SingleTask.Description
                                </p>
                            </div>
                        </div>
                        <div class="col-4 flex flex-end">
                            <button 
                                type="button"
                                class="btn-success btn-base btn-base-p mr-4"
                                onclick="openEditModal(this)"
                                data-id="@SingleTask.Id"
                                data-title="@SingleTask.Title"
                                data-description="@SingleTask.Description"
                                data-important="@SingleTask.Important.ToString().ToLower()"
                                data-completed="@SingleTask.Completed.ToString().ToLower()"
                            >
                                Edit
                            </button>
                            <button 
                                type="button" 
                                class="btn-danger btn-base btn-base-p"
                                onclick="openDeleteModal(this)"
                                data-id="@SingleTask.Id"
                                data-title="@SingleTask.Title"
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
    <dialog id="modalCreate">
        <partial name="_Create">
    </dialog>
    <dialog id="modalEdit">
        <partial name="_Edit">
    </dialog>
    <dialog id="modalDelete">
        <partial name="_Delete">
    </dialog>
</div>

@functions{
    public string CompletedTask(bool Completed, bool Container){
        if(Container){
            return Completed ? "bg-completed border-completed" : " bg-grey border-base-c";
        } else {
            return Completed ? "task-completed" : "";
        }
    }
}

@section Scripts {
    <script src="~/js/createModal.js" asp-append-version="true"></script>
    <script src="~/js/editModal.js" asp-append-version="true"></script>
    <script src="~/js/deleteModal.js" asp-append-version="true"></script>
}

