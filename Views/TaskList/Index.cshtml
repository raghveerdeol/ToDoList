@model IEnumerable<ToDoList.Models.TaskList>
@{
    ViewData["Title"] = "Index";
}

<div class="flex flex-center text-center">
    <h1 class="col-12">To DO List</h1>
    <div class="col-8 mt-8">
        <a type="button" class="btn-base btn-success" href="/TaskList/Create">Add Task</a>
        <ul>
            @foreach (var SingleTask in Model)
            {
                <li>
                    <div class="flex flex-center text-start mt-8 col-12 item-border p-list-item bg-grey">
                        <div class="col-8">
                            <div class="mr-4">
                                @* <form action="Complete" method="post">
                                    <input type="checkbox" name="completed" asp-for="Completed">
                                </form> *@
                            </div>
                            <div>
                                <h4>
                                    @SingleTask.Title
                                    @if(@SingleTask.Important)
                                    {
                                        <span class="color-yellow">
                                            &#127775;
                                        </span>
                                    }
                                </h4>
                                <p>
                                    @SingleTask.Description
                                </p>
                            </div>
                        </div>
                        <div class="col-4 flex flex-end">
                            <button 
                                type="button"
                                class="btn-success btn-base mr-4"
                                onclick="openEditModal(this)"
                                data-id="@SingleTask.Id"
                                data-title="@SingleTask.Title"
                                data-description="@SingleTask.Description"
                                data-important="@SingleTask.Important.ToString().ToLower()"
                                data-completed="@SingleTask.Completed.ToString().ToLower()"
                            >
                                Edit
                            </button>
                            <button 
                                type="button" 
                                class="btn-danger btn-base"
                                onclick="openDeleteModal(this)"
                                data-id="@SingleTask.Id"
                                data-title="@SingleTask.Title"
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
    <dialog id="modalEdit">
        <partial name="_Edit">
    </dialog>
    <dialog id="modalDelete">
        <partial name="_Delete">
    </dialog>
</div>

@section Scripts {
    <script src="~/js/editModal.js" asp-append-version="true"></script>
    <script src="~/js/deleteModal.js" asp-append-version="true"></script>
}

