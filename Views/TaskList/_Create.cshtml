
<div class="flex flex-center text-center">
    <h4 class="col-12">Create Task</h4>
    <div class="col-6">
        <form asp-action="Create" method="post">
            <div>
                <div>
                    <label for="Title">Title</label>
                    <input type="text" name="Title">
                </div>
                <div>
                    <label for="Description">Description</label>
                    <input type="text" name="Description">
                </div>
                <div>
                    <label for="Important">Important</label>
                    <input type="checkbox" name="Important" value="true">
                </div>
                <button type="submit" class="btn-base btn-success">Save</button>
            </div>
        </form>
        <button type="button" class="btn-base btn-danger" onclick="closeCreateModal()">Cancel</button>
    </div>
</div>