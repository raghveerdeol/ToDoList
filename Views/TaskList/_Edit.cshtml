<div>
    <div class="flex flex-end">
        <button type="button" class="btn-base btn-danger btn-base-p" onclick="closeEditModal()">X</button>
    </div>
    <div class="mt-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" id="edit-id" name="Id">
            <div class="mt-1 flex space-between">
                <label for="Title">Title</label>
                <input type="text" id="edit-title" name="Title">
            </div>
            <div class="mt-1 flex space-between">
                <label for="Description">Description</label>
                <input type="text" id="edit-description" name="Description">
            </div>
            <div class="mt-1 flex space-between">
                <label for="Important">Important</label>
                <input type="checkbox" id="edit-important" name="Important" value="true">
            </div>
            <div class="mt-1 flex space-between">
                <label for="Completed">Completed</label>
                <input type="checkbox" id="edit-completed" name="Completed" value="true">
            </div>
            <button type="submit" class="btn-base btn-success btn-base-p">Save</button>
        </form>
</div>
</div>